# Resend (transactional email for the quote form)
# Get an API key at https://resend.com
RESEND_API_KEY=

# Inbox that should receive quote requests
QUOTE_TO_EMAIL=mohamed@mozasystems.com

# Verified sending address on your Resend domain, e.g. "Moza Systems <quote@mozasystems.com>"
# Until a domain is verified in Resend, leave this unset to use Resend's
# shared sandbox address for testing only (it will not reliably deliver to
# arbitrary inboxes in production).
RESEND_FROM_EMAIL=
